# =============================================================================
# Bescom - PRODUCTION template (copy to .env and fill in). Secrets are intentionally empty.
# Every key below is read by the code; nothing else is needed. Never commit this file.
# The repo .env is the local fake-postgres testing profile; this file shows the production values.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=1
# Comma-separated browser origins allowed to call the API (React dev server / preview)
ALLOWED_ORIGINS=https://your-domain.example

# ---- Auth -------------------------------------------------------------------
# Signs login tokens. >= 32 chars. [PROD] generate a new one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# [PROD] false once your users exist (otherwise anyone can sign up and use the senders)
ALLOW_REGISTRATION=false
# Usernames that get the admin role when they register. [PROD] leave empty and create the admin deliberately.
ADMIN_USERNAMES=
# Key for the service-to-service endpoints POST /api/agent/email/send and /whatsapp/send (empty = disabled)
AGENT_API_KEY=

# ---- Database ---------------------------------------------------------------
# fake     = SQLite stand-in for Postgres (testing)
# auto     = real PostgreSQL if reachable, else the fake
# postgres = real PostgreSQL only; refuses to start without it   <- production
AGENT_DB_MODE=postgres
# Used when AGENT_DB_MODE is auto/postgres, e.g. postgresql://user:pass@host:5432/dbname
AGENT_DATABASE_URL=
# ...or the same thing as separate parts (the password needs no URL-encoding). The URL above wins if both are set.
# Local Postgres: host localhost. VM: the VM's IP / hostname (same value works inside Docker).
AGENT_DB_HOST=
AGENT_DB_PORT=5432
AGENT_DB_NAME=agents
AGENT_DB_USER=agents
AGENT_DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full  (empty = libpq default). Use require+ for a remote DB.
AGENT_DB_SSLMODE=
# Startup wait for a database that is still booting (postgres mode), pool tuning for a remote DB
AGENT_DB_CONNECT_RETRIES=5
AGENT_DB_CONNECT_RETRY_DELAY=3
AGENT_DB_POOL_SIZE=5
# Fake postgres file (relative to the project root; in Docker it lives on a volume)
FAKE_POSTGRES_URL=sqlite:///data/fake_postgres.db
# Seeds users admin / demo and sample contacts (never in production)
FAKE_POSTGRES_SEED=false
FAKE_POSTGRES_ADMIN_PASSWORD=
FAKE_POSTGRES_DEMO_PASSWORD=

# ---- Orchestrator (local Ollama) -------------------------------------------
# Native run: http://localhost:11434 ; docker compose overrides this (see docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
ORCHESTRATOR_LLM_PROVIDER=ollama
ORCHESTRATOR_OLLAMA_MODEL=mistral
ORCHESTRATOR_LLM_TIMEOUT=30
ORCHESTRATOR_LLM_COOLDOWN=60

# ---- Agent behaviour --------------------------------------------------------
# true = validate and render everything but send nothing. [PROD] false
AGENT_DRY_RUN=false
AGENT_REQUIRE_AUTH=true
AGENT_REQUIRE_CONFIRMATION=true
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_MAX_CLARIFICATIONS=5
AGENT_DRAFT_TIMEOUT=60
# Optional: only these roles may send, e.g. admin  (empty = any signed-in user)
AGENT_SEND_ALLOWED_ROLES=

# ---- Email service agent (SMTP) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
# Optional: only allow these recipient domains, e.g. yourcompany.com,partner.com
EMAIL_ALLOWED_DOMAINS=
EMAIL_MAX_RECIPIENTS=50

# ---- WhatsApp agent: "meta" (WhatsApp Cloud API) or "twilio" ----------------
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template for business-initiated messages (free text is only allowed within 24h of a customer message)
WHATSAPP_DEFAULT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional: override the provider endpoints (staging mocks). Leave empty/unset for the real APIs.
# WHATSAPP_META_BASE_URL=https://graph.facebook.com
# TWILIO_API_BASE_URL=https://api.twilio.com
# Used to complete numbers written without a country code
DEFAULT_COUNTRY_CODE=91

# ---- docker compose only ----------------------------------------------------
# Where the app container finds Ollama. Default: Ollama on your machine. For the compose Ollama service:
# OLLAMA_URL_IN_DOCKER=http://ollama:11434
# docker-compose.postgres.yml
POSTGRES_USER=agents
POSTGRES_PASSWORD=
POSTGRES_DB=agents

# ---- Grafana monitoring (docker-compose.postgres.yml) -----------------------
# Letters and digits only. Grafana reads the app's metrics_* tables with the read-only role grafana_ro.
GRAFANA_RO_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
# Monitoring events are stored in the agent database; older ones are deleted. METRICS_ENABLED=false turns it off.
METRICS_ENABLED=true
METRICS_RETENTION_DAYS=30
