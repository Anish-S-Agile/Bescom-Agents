    {
      "id": 12,
      "type": "table",
      "title": "LLM outcomes by operation and status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agents-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agents-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model, operation, status, count(*) AS calls, round(avg(duration_ms)::numeric / 1000, 2) AS \"avg s\", round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms))::numeric / 1000, 2) AS \"p95 s\", max(ts) AS \"last seen\" FROM metrics_llm_calls WHERE $__timeFilter(ts) GROUP BY 1, 2, 3 ORDER BY calls DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
